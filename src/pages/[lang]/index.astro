---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BlogCard from '../../components/BlogCard.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { t } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const locale = (lang === 'en' ? 'en' : 'zh') as 'zh' | 'en';
const projects = (await getCollection('projects', ({ id }) => id.startsWith(locale + '/')))
  .sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ id }) => id.startsWith(locale + '/')))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const workbenchItems: Array<{
  title: string;
  label: string;
  href: string;
  tone: 'lime' | 'butter' | 'lavender' | 'paper';
}> = projects.slice(0, 4).map((entry, index) => ({
  title: entry.data.title,
  label: `PROJECT / 0${index + 1}`,
  href: `/${locale}/projects/${entry.id.split('/')[1]}/`,
  tone: (['lime', 'butter', 'lavender', 'paper'] as const)[index % 4],
}));
---
<BaseLayout title={t(locale, 'hero.role')}>
  <Nav locale={locale} />
  <Hero locale={locale} workbenchItems={workbenchItems} />
  <main>
    <section id="projects" class="section">
      <div class="container">
        <SectionHeader num="01" title={t(locale, 'section.projects')} desc={t(locale, 'section.projects.desc')} />
        <div class="project-grid">
          {projects.map((p) => <ProjectCard entry={p} />)}
        </div>
      </div>
    </section>
    <section id="blog" class="section">
      <div class="container">
        <SectionHeader num="02" title={t(locale, 'section.blog')} desc={t(locale, 'section.blog.desc')} />
        <div class="blog-list">
          {posts.map((post) => <BlogCard entry={post} />)}
        </div>
        <a href={`/${locale}/blog/`} class="all-link">{t(locale, 'blog.all')} →</a>
      </div>
    </section>
    <section id="tooling" class="section">
      <div class="container">
        <SectionHeader num="03" title={locale === 'zh' ? 'AI Coding 工具与开发习惯' : 'AI Coding Tools & Dev Habits'} desc={locale === 'zh' ? '我在终端里怎么用 AI 干活——工具清单、套餐取舍与当前的使用范式' : 'How I actually use AI in the terminal — the tools, the plans, and my current setup'} />
        {locale === 'zh' ? (
          <div class="tooling-body">
            <p class="tooling-lead">我习惯在<strong>终端命令行</strong>里跑代码。所有 AI coding Agent 都住在同一个终端里，我靠一套自洽的工具链调度它们。</p>

            <h3 class="tooling-h3">用到的开源工具</h3>
            <div class="tool-list">
              <div class="tool-card">
                <span class="tool-tag t-multi">终端多路复用器</span>
                <h4><a href="https://github.com/ogulcancelik/herdr" target="_blank" rel="noopener">herdr</a></h4>
                <p>Agent 专属的终端复用器：把多个 coding Agent 放进同一屏，实时显示 blocked / working / done 状态，哪个卡住等确认一眼看到；session 可 detach/reattach，断线不丢进度。我日常就是一个 pane 一个 Agent，靠状态灯而不是轮询来调度注意力。</p>
              </div>
              <div class="tool-card">
                <span class="tool-tag t-dsh">Agent 框架 + TUI</span>
                <h4><a href="https://github.com/deepseek-ai/deepseek-harness" target="_blank" rel="noopener">dsh · DeepSeek Harness</a> / <a href="https://github.com/Ethanz11-creat/dsh-billing-tui" target="_blank" rel="noopener">dsh-billing-tui</a></h4>
                <p>DeepSeek 官方的 Agent Harness，一切皆插件；我主要是通过它的 TUI 用它跑 DeepSeek 模型。我还给它写了一个 <a href="https://github.com/Ethanz11-creat/dsh-billing-tui" target="_blank" rel="noopener">dsh-billing-tui</a>：按峰谷分时计价实时算 token 费用并在状态栏显示，编码时心里有数。</p>
              </div>
              <div class="tool-card">
                <span class="tool-tag t-codex">主 Agent</span>
                <h4><a href="https://github.com/openai/codex" target="_blank" rel="noopener">Codex CLI</a></h4>
                <p>OpenAI 的终端编码 Agent。我拿它当<strong>主 Agent / 决策者</strong>：制定计划、分解任务、做验收。纯终端、支持 AGENTS.md 指令、沙箱与审批策略，适合做"先想清楚再动手"的角色。</p>
              </div>
              <div class="tool-card">
                <span class="tool-tag t-claude">子 Agent / 探索</span>
                <h4><a href="https://github.com/anthropics/claude-code" target="_blank" rel="noopener">Claude Code</a></h4>
                <p>Anthropic 的终端编码 Agent。Skills、CLAUDE.md、子代理生态成熟，我拿它做探索与"洗 AI 味"这类需要设计判断的活，或者跟 Codex 交叉审查。</p>
              </div>
              <div class="tool-card">
                <span class="tool-tag t-browser">浏览器自动化</span>
                <h4><a href="https://github.com/citrolabs/ego-lite" target="_blank" rel="noopener">ego lite</a></h4>
                <p>让 Agent 直接用我登录态的浏览器，在独立 Space 里跑自动化任务，不跟我抢标签页。给 Agent 做真实导航、截图、填表验证前端时我在用。</p>
              </div>
            </div>

            <h3 class="tooling-h3">体验过的 Coding 套餐</h3>
            <p class="tooling-p">我用过 <strong>Claude 20x</strong> 和 <strong>GPT 20x</strong> 的高档套餐——确实强，但 20x 的价格对我是明显负担。财力有限的前提下，稳定用下来的是两个 <strong>20 美元档</strong>：<strong>ChatGPT Plus（$20）</strong> + <strong>Ollama Pro（$20）</strong> 的 coding plan。</p>

            <h3 class="tooling-h3">当前的使用范式</h3>
            <p class="tooling-p"><strong>当一个套餐配额不够时，我把"强推理 + 便宜执行"拆开用：</strong></p>
            <ul class="tooling-ul">
              <li><strong>主力执行</strong>：在 herdr 的一个 pane 里，用 <strong>dsh-tui</strong> 调 <strong>Ollama Cloud 的 DeepSeek V4 正式版</strong>跑重活（写代码、批量处理），成本低、跑得久不怕烧钱。</li>
              <li><strong>决策与验收</strong>：同一个 herdr session 里再开一个 pane，<strong>Codex</strong> 作为主 Agent 负责决策、拆计划、做代码评审和最后验收——只在关键节点用贵额度，省着花。</li>
              <li><strong>子 Agent 执行</strong>：把 <strong>DeepSeek V4 Flash 正式版</strong>当子 Agent，交给我拆好的小块任务执行，然后回传给 Codex 验收。</li>
            </ul>
            <p class="tooling-p">一句话：终端是主场，herdr 是调度台，代码/贵额度当大脑，DeepSeek 的便宜模型当手脚——预算有限反而逼出了更清晰的"谁负责想、谁负责干"的分工。</p>
          </div>
        ) : (
          <div class="tooling-body">
            <p class="tooling-lead">I work in the <strong>terminal</strong>. All my AI coding agents live in the same terminal, and I orchestrate them with one self-contained toolchain.</p>

            <h3 class="tooling-h3">Open-source tools I use</h3>
            <div class="tool-list">
              <div class="tool-card">
                <span class="tool-tag t-multi">Terminal multiplexer</span>
                <h4><a href="https://github.com/ogulcancelik/herdr" target="_blank" rel="noopener">herdr</a></h4>
                <p>An agent-aware terminal multiplexer: run multiple coding agents side by side with live blocked / working / done status, so I know in one glance which one is waiting for me. Sessions detach/reattach, so nothing is lost on disconnect. One agent per pane, scheduled by status lights instead of polling.</p>
              </div>
              <div class="tool-card">
                <span class="tool-tag t-dsh">Agent framework + TUI</span>
                <h4><a href="https://github.com/deepseek-ai/deepseek-harness" target="_blank" rel="noopener">dsh · DeepSeek Harness</a> / <a href="https://github.com/Ethanz11-creat/dsh-billing-tui" target="_blank" rel="noopener">dsh-billing-tui</a></h4>
                <p>DeepSeek's official Agent Harness — everything is a plugin. I mainly drive DeepSeek models through its TUI, and I wrote a <a href="https://github.com/Ethanz11-creat/dsh-billing-tui" target="_blank" rel="noopener">dsh-billing-tui</a>: it computes real-time token cost with peak/off-peak metering and shows it in the status bar.</p>
              </div>
              <div class="tool-card">
                <span class="tool-tag t-codex">Main agent</span>
                <h4><a href="https://github.com/openai/codex" target="_blank" rel="noopener">Codex CLI</a></h4>
                <p>OpenAI's terminal coding agent. I use it as the <strong>main agent / decision-maker</strong>: making plans, breaking down tasks, and doing acceptance. Pure terminal, supports AGENTS.md, sandboxing and approval policies — good for a "think first, then act" role.</p>
              </div>
              <div class="tool-card">
                <span class="tool-tag t-claude">Sub agent / exploration</span>
                <h4><a href="https://github.com/anthropics/claude-code" target="_blank" rel="noopener">Claude Code</a></h4>
                <p>Anthropic's terminal coding agent. Mature Skills, CLAUDE.md and subagent ecosystem — I use it for exploration and for design-sensitive work like de-AI-ifying the frontend, or for cross-review with Codex.</p>
              </div>
              <div class="tool-card">
                <span class="tool-tag t-browser">Browser automation</span>
                <h4><a href="https://github.com/citrolabs/ego-lite" target="_blank" rel="noopener">ego lite</a></h4>
                <p>Lets agents drive a browser that reuses my logged-in state, running automation in their own Space without fighting me for tabs. I use it for real navigation, screenshots and form-filling when verifying UI.</p>
              </div>
            </div>

            <h3 class="tooling-h3">Coding plans I've tried</h3>
            <p class="tooling-p">I've used the higher-end <strong>Claude 20x</strong> and <strong>GPT 20x</strong> tiers — powerful, but at a price that's hard to justify. On a budget, my stable setup is two <strong>$20 tiers</strong>: <strong>ChatGPT Plus</strong> + the <strong>Ollama Pro coding plan</strong>.</p>

            <h3 class="tooling-h3">My current setup</h3>
            <p class="tooling-p"><strong>When a single plan's quota isn't enough, I split "strong reasoning" from "cheap execution":</strong></p>
            <ul class="tooling-ul">
              <li><strong>Heavy lifting</strong>: in one herdr pane, <strong>dsh-tui</strong> calls <strong>Ollama Cloud's DeepSeek V4 (official)</strong> for the bulk work — writing code, batch processing — low cost, fine to run long.</li>
              <li><strong>Decisions &amp; acceptance</strong>: another pane in the same herdr session runs <strong>Codex</strong> as the main agent — deciding, decomposing, reviewing and accepting. I only spend the expensive quota at the key checkpoints.</li>
              <li><strong>Execution sub-agents</strong>: <strong>DeepSeek V4 Flash (official)</strong> acts as sub-agents for the small tasks I hand it, reporting back to Codex for acceptance.</li>
            </ul>
            <p class="tooling-p">In short: the terminal is home base, herdr is the control room, expensive models are the brain, and DeepSeek's cheap models are the hands — a tight budget pushed me into a cleaner "who thinks, who does" split.</p>
          </div>
        )}
      </div>
    </section>
    <section id="about" class="section">
      <div class="container">
        <SectionHeader num="04" title={t(locale, 'section.about')} />
        {locale === 'zh' ? (
          <div class="about-body">
            <p class="about-lead">你好，我是赵一恒——厦门大学电子信息类硕士，研究方向 LLM / RAG / Agent。我用 AI 构建 Agent，也构建一切，把「怎么做 Agent」的方法论和作品一起沉淀在这里。</p>

            <div class="about-block">
              <h3 class="about-h3">教育背景</h3>
              <ul class="about-edu">
                <li><strong>厦门大学</strong> · 电子信息类 · 硕士（985）—— LLM / RAG / Agent 方向，2024–2027</li>
                <li><strong>中国地质大学（武汉）</strong> · 自动化 · 本科（211），2020–2024</li>
              </ul>
            </div>

            <div class="about-block">
              <h3 class="about-h3">研究方向</h3>
              <div class="stack-tags">
                {['LLM', 'RAG', 'Agent', '安全知识推理', '神经符号检索', '低空经济智能问答'].map((s) => <span class="tag">{s}</span>)}
              </div>
            </div>

            <div class="about-block">
              <h3 class="about-h3">学术成果</h3>
              <div class="achievements">
                <div class="ach-card">
                  <span class="ach-type t-paper">综述论文</span>
                  <h4>低空运行安全的大模型技术综述</h4>
                  <p>SESC 2026 录用 · 推荐至《系统工程理论与实践》</p>
                  <span class="ach-status">录用</span>
                </div>
                <div class="ach-card">
                  <span class="ach-type t-soft">软件著作权</span>
                  <h4>低空经济洞察平台 · 产业政策智能分析系统 V1.0</h4>
                  <p>《低空经济洞察平台产业政策智能分析系统 V1.0》</p>
                  <span class="ach-status">登记号 2026SR0424325</span>
                </div>
                <div class="ach-card">
                  <span class="ach-type t-paper">论文 · 在投</span>
                  <h4>Constraint-Guided Neuro-Symbolic Causal Evidence Subgraph Retrieval for Safety Knowledge Reasoning</h4>
                  <p>约束引导的神经-符号方法，面向因果证据子图检索</p>
                  <span class="ach-status">在投</span>
                </div>
              </div>
            </div>

            <div class="about-block">
              <h3 class="about-h3">下一篇论文的思路</h3>
              <p class="about-research">面向安全知识推理，用<strong>约束引导的神经-符号方法</strong>做<strong>因果证据子图检索</strong>——在知识图谱上只检索"能支撑结论的因果证据链"，相比传统 RAG 的语义召回，强调证据的<strong>可解释性与可靠性</strong>，与我在 Agent 里坚持的"证据不足即回答=失败"一脉相承。</p>
            </div>

            <div class="about-block">
              <h3 class="about-h3">技术栈</h3>
              <div class="stack-group">
                <p class="stack-label">语言 / 平台</p>
                <div class="stack-tags">{['Python', 'Swift 6', 'Go', 'TypeScript', 'React'].map((s) => <span class="tag">{s}</span>)}</div>
                <p class="stack-label">Agent / RAG</p>
                <div class="stack-tags">{['Tool Calling', 'Memory', 'MCP', 'Skills', 'Eino ADK', 'LangChain', 'FAISS', 'Query Rewrite', '混合召回'].map((s) => <span class="tag">{s}</span>)}</div>
                <p class="stack-label">评测 / Observability</p>
                <div class="stack-tags">{['Benchmark 评测', 'LLM-as-Judge', 'HITL', 'OTel', 'Phoenix'].map((s) => <span class="tag">{s}</span>)}</div>
              </div>
            </div>

            <p class="about-cta">进一步了解我的背景，见<a href="/resume.pdf" target="_blank" rel="noopener">简历 PDF</a>。</p>
          </div>
        ) : (
          <div class="about-body">
            <p class="about-lead">Hi, I'm Yiheng Zhao — an MS student in Electronic Information at Xiamen University, researching LLM / RAG / Agent. I build agents with AI, and everything else with AI, distilling both the methodology and the shipped work here.</p>

            <div class="about-block">
              <h3 class="about-h3">Education</h3>
              <ul class="about-edu">
                <li><strong>Xiamen University</strong> · Electronic Information · MS (985) — LLM / RAG / Agent, 2024–2027</li>
                <li><strong>China University of Geosciences (Wuhan)</strong> · Automation · BS (211), 2020–2024</li>
              </ul>
            </div>

            <div class="about-block">
              <h3 class="about-h3">Research interests</h3>
              <div class="stack-tags">
                {['LLM', 'RAG', 'Agent', 'Safety reasoning', 'Neuro-symbolic retrieval', 'Low-altitude QA'].map((s) => <span class="tag">{s}</span>)}
              </div>
            </div>

            <div class="about-block">
              <h3 class="about-h3">Selected outputs</h3>
              <div class="achievements">
                <div class="ach-card">
                  <span class="ach-type t-paper">Survey</span>
                  <h4>A Survey of LLM Technologies for Low-Altitude Operation Safety</h4>
                  <p>Accepted at SESC 2026 · recommended to Systems Engineering — Theory &amp; Practice</p>
                  <span class="ach-status">Accepted</span>
                </div>
                <div class="ach-card">
                  <span class="ach-type t-soft">Software copyright</span>
                  <h4>Low-Altitude Economy Insight Platform · Industry-Policy Intelligent Analysis System V1.0</h4>
                  <p>Software copyright registration</p>
                  <span class="ach-status">Reg. 2026SR0424325</span>
                </div>
                <div class="ach-card">
                  <span class="ach-type t-paper">Paper · under review</span>
                  <h4>Constraint-Guided Neuro-Symbolic Causal Evidence Subgraph Retrieval for Safety Knowledge Reasoning</h4>
                  <p>A constraint-guided neuro-symbolic method for causal evidence subgraph retrieval</p>
                  <span class="ach-status">Under review</span>
                </div>
              </div>
            </div>

            <div class="about-block">
              <h3 class="about-h3">Where my next paper is headed</h3>
              <p class="about-research">For safety knowledge reasoning, a <strong>constraint-guided neuro-symbolic</strong> approach to <strong>causal evidence subgraph retrieval</strong> — retrieving, from a knowledge graph, only the causal evidence chains that actually support a conclusion, prioritizing <strong>explainability and evidence reliability</strong> over plain semantic recall. It follows the same principle I hold in agents: answering without sufficient evidence is a failure.</p>
            </div>

            <div class="about-block">
              <h3 class="about-h3">Stack</h3>
              <div class="stack-group">
                <p class="stack-label">Languages / Platforms</p>
                <div class="stack-tags">{['Python', 'Swift 6', 'Go', 'TypeScript', 'React'].map((s) => <span class="tag">{s}</span>)}</div>
                <p class="stack-label">Agent / RAG</p>
                <div class="stack-tags">{['Tool Calling', 'Memory', 'MCP', 'Skills', 'Eino ADK', 'LangChain', 'FAISS', 'Query Rewrite', 'Hybrid retrieval'].map((s) => <span class="tag">{s}</span>)}</div>
                <p class="stack-label">Evals / Observability</p>
                <div class="stack-tags">{['Benchmark evals', 'LLM-as-Judge', 'HITL', 'OTel', 'Phoenix'].map((s) => <span class="tag">{s}</span>)}</div>
              </div>
            </div>

            <p class="about-cta">For my full background, see the <a href="/resume.pdf" target="_blank" rel="noopener">résumé PDF</a>.</p>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  :global(.project-grid .project-card) {
    border: 2px solid var(--ink);
    border-radius: 3px;
    box-shadow: var(--shadow);
  }
  :global(.project-grid .project-card:first-child) {
    background: var(--paper);
  }
  .blog-list {
    max-width: 760px;
  }
  .all-link {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--accent-deep);
    font-size: 0.95rem;
  }
  .about-body { max-width: 920px; }
  .about-lead {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    margin-bottom: 2.5rem;
    max-width: 30em;
  }
  .about-block { margin: 0 0 2.25rem; }
  .about-h3 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 1.1rem;
  }
  .about-edu { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .about-edu li { font-size: 0.95rem; line-height: 1.7; color: var(--ink-secondary); }
  .about-research { font-size: 1rem; line-height: 1.85; color: var(--ink-secondary); margin: 0; max-width: 44em; }
  .about-research strong { color: var(--ink); font-weight: 600; }
  .stack-group { display: flex; flex-direction: column; gap: 0.6rem; }
  .stack-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin: 0.4rem 0 0;
  }
  .stack-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    padding: 0.3rem 0.55rem;
    box-shadow: 2px 2px 0 var(--ink);
  }
  .achievements { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; }
  .ach-card {
    border: 2px solid var(--ink);
    border-radius: 4px;
    box-shadow: 4px 4px 0 var(--ink);
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .ach-type {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.22rem 0.5rem;
    border-radius: 3px;
  }
  .t-paper { background: var(--lavender); color: var(--ink); }
  .t-soft { background: var(--butter); color: var(--ink); }
