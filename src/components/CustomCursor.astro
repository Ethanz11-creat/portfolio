---
---

<div class="custom-cursor" aria-hidden="true">
</div>

<script>
  const cursor = document.querySelector<HTMLElement>('.custom-cursor');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (cursor) {
    const interactiveSelector = 'a, button, input, select, textarea, label, [role="button"]';
    let active = false;

    const setPosition = (event: PointerEvent) => {
      cursor.style.setProperty('--cursor-x', `${event.clientX}px`);
      cursor.style.setProperty('--cursor-y', `${event.clientY}px`);
      cursor.classList.add('is-visible');
      document.body.classList.add('cursor-ready');
    };

    const setInteractiveState = (target: EventTarget | null) => {
      const isInteractive = target instanceof Element && Boolean(target.closest(interactiveSelector));
      cursor.classList.toggle('is-active', isInteractive);
    };

    const onPointerOver = (event: PointerEvent) => setInteractiveState(event.target);
    const onPointerDown = () => cursor.classList.add('is-pressed');
    const onPointerUp = () => {
      cursor.classList.remove('is-pressed');
      cursor.classList.remove('is-clicked');
      // Restart the pulse even when the user clicks repeatedly.
      requestAnimationFrame(() => cursor.classList.add('is-clicked'));
      window.setTimeout(() => cursor.classList.remove('is-clicked'), 460);
    };
    const hide = () => cursor.classList.remove('is-visible');

    const enable = () => {
      if (active || !finePointer.matches || reducedMotion.matches) return;
      active = true;
      window.addEventListener('pointermove', setPosition, { passive: true });
      document.addEventListener('pointerover', onPointerOver, { passive: true });
      window.addEventListener('pointerdown', onPointerDown, { passive: true });
      window.addEventListener('pointerup', onPointerUp, { passive: true });
      window.addEventListener('blur', hide);
    };

    const disable = () => {
      if (!active) return;
      active = false;
      document.body.classList.remove('cursor-ready');
      cursor.classList.remove('is-visible', 'is-active', 'is-pressed');
      window.removeEventListener('pointermove', setPosition);
      document.removeEventListener('pointerover', onPointerOver);
      window.removeEventListener('pointerdown', onPointerDown);
      window.removeEventListener('pointerup', onPointerUp);
      window.removeEventListener('blur', hide);
    };

    const update = () => (finePointer.matches && !reducedMotion.matches ? enable() : disable());
    finePointer.addEventListener('change', update);
    reducedMotion.addEventListener('change', update);
    update();
  }
</script>

<style>
  .custom-cursor {
    --cursor-x: -100px;
    --cursor-y: -100px;
    align-items: center;
    -webkit-backdrop-filter: invert(1) brightness(0.78);
    backdrop-filter: invert(1) brightness(0.78);
    background: rgba(0, 0, 0, 0.08);
    border: 0;
    border-radius: 50%;
    display: flex;
    height: 62px;
    justify-content: center;
    left: 0;
    opacity: 0;
    pointer-events: none;
    position: fixed;
    top: 0;
    transform: translate3d(var(--cursor-x), var(--cursor-y), 0) translate(-50%, -50%);
    transition: width 180ms ease, height 180ms ease, opacity 120ms ease, transform 80ms linear;
    width: 62px;
    z-index: 1000;
  }

  .custom-cursor::after {
    border: 1px solid rgba(255, 253, 247, 0.9);
    border-radius: 50%;
    content: '';
    inset: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
  }

  .custom-cursor.is-visible {
    opacity: 1;
  }

  .custom-cursor.is-active {
    height: 78px;
    width: 78px;
  }

  .custom-cursor.is-pressed {
    height: 48px;
    width: 48px;
  }

  .custom-cursor.is-clicked::after {
    animation: cursor-pulse 450ms ease-out;
  }

  @keyframes cursor-pulse {
    0% {
      opacity: 0.85;
      transform: scale(0.75);
    }
    100% {
      opacity: 0;
      transform: scale(1.7);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    :global(body.cursor-ready),
    :global(body.cursor-ready *) {
      cursor: none !important;
    }
  }
</style>
