---
import type { CollectionEntry } from 'astro:content';
import { t } from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'tools'>;
}

const { entry } = Astro.props;
const { title, subtitle, tags, github } = entry.data;
const locale = entry.id.split('/')[0] === 'en' ? 'en' : 'zh';
---
<div class="tool-card" data-reveal>
  <div class="tool-head">
    <h4>{title}</h4>
    {github && (
      <a href={github} target="_blank" rel="noopener" class="gh">{t(locale, 'project.github')}</a>
    )}
  </div>
  <p class="subtitle">{subtitle}</p>
  <ul class="tags">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</div>

<style>
  .tool-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.4rem 1.6rem;
    transition: transform 0.25s, border-color 0.25s;
  }
  .tool-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .tool-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 0.4rem;
  }
  .tool-head h4 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }
  .gh {
    font-size: 0.8rem;
    color: var(--accent);
    white-space: nowrap;
  }
  .subtitle {
    color: var(--ink-secondary);
    font-size: 0.9rem;
    margin-bottom: 0.9rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags li {
    font-size: 0.75rem;
    color: var(--ink-secondary);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
</style>
